# ============================================================
# Affiliate Auto-Content & Video Pipeline (TikTok / Shopee)
# ============================================================

# Set to true to test the full pipeline end-to-end (Mock AI + real FFmpeg + Mock Drive)
# without needing real Gemini or Google Service Account credentials.
MOCK_MODE=true

# Database (SQLite by default)
DATABASE_URL=sqlite:///./affiliate_pipeline.db

# Local checkpoint & temporary output directory
TMP_OUTPUTS_DIR=./tmp_outputs

# Background worker concurrency (ThreadPoolExecutor, no Redis required)
WORKER_MAX_WORKERS=2

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------
# Gemini API (Required when MOCK_MODE=false)
# Get your key from https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# Video Provider Strategy: "ffmpeg" (default, free local) | "external"
# ------------------------------------------------------------
VIDEO_PROVIDER=ffmpeg
FFMPEG_BIN=ffmpeg
# Optional custom Thai TTF/OTF font path for hook text overlay (auto-detected if empty)
THAI_FONT_PATH=
VIDEO_DURATION_SECONDS=5
VIDEO_FPS=30

# External I2V API settings (Used only when VIDEO_PROVIDER=external)
# Supported adapters: veo | kling | runway
EXTERNAL_VIDEO_API_PROVIDER=veo
EXTERNAL_VIDEO_API_KEY=
EXTERNAL_VIDEO_API_BASE_URL=

# ------------------------------------------------------------
# Google Drive Auto-Sync via Service Account (Required when MOCK_MODE=false)
# IMPORTANT: Share the target Google Drive folder with the Service Account's
# client_email (Editor role). Never use 7-day expiring user OAuth tokens.
# ------------------------------------------------------------
# Local dev: path to service_account.json file
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
# Cloud PaaS (Render / Railway / Cloud Run): paste raw JSON OR Base64-encoded JSON here instead of uploading a file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
